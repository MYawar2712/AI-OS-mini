# Copy this file to .env and fill in. .env is git-ignored: never commit real keys.
# Everything that is NOT a secret lives in config/settings.yaml instead.

# Required for the AI assistant. Alibaba Cloud Model Studio (International region) API key.
# Without it the app still runs, but every ticket is sent to manual triage.
DASHSCOPE_API_KEY=sk-REPLACE_ME

# Optional: also post approved escalations to a Slack or Microsoft Teams channel (incoming-webhook URL).
# Without it, escalations are saved to data/integrations/escalations.jsonl and shown on the Activity page.
# ESCALATION_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# Optional: store the runtime files (ticket queue, customer database, escalations) in another folder.
# TRIAGE_DATA_DIR=C:\path\to\folder
# Optional: folder for the audit log, app log and suggestions (default data/runs).
# TRIAGE_RUNS_DIR=C:\path\to\folder

# Optional alternative LLM provider (also set llm.provider: anthropic in config/settings.yaml).
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
