{
  "additionalProperties": false,
  "description": "What the triage system must return. Validated before anything is written to the ticketing system.",
  "properties": {
    "ticket_id": {
      "title": "Ticket Id",
      "type": "string"
    },
    "intent": {
      "enum": [
        "technical_issue",
        "mobile_app_sync",
        "billing_invoice",
        "payment_failure",
        "scheduling_dispatch",
        "account_access",
        "data_import_export",
        "feature_request",
        "cancellation_churn_risk",
        "general_inquiry",
        "out_of_scope"
      ],
      "title": "Intent",
      "type": "string"
    },
    "secondary_intent": {
      "anyOf": [
        {
          "enum": [
            "technical_issue",
            "mobile_app_sync",
            "billing_invoice",
            "payment_failure",
            "scheduling_dispatch",
            "account_access",
            "data_import_export",
            "feature_request",
            "cancellation_churn_risk",
            "general_inquiry",
            "out_of_scope"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Secondary Intent"
    },
    "priority": {
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "title": "Priority",
      "type": "string"
    },
    "queue": {
      "enum": [
        "tier1_general",
        "tier2_technical",
        "billing",
        "customer_success_retention",
        "onboarding_data",
        "product"
      ],
      "title": "Queue",
      "type": "string"
    },
    "escalate": {
      "title": "Escalate",
      "type": "boolean"
    },
    "escalation_reasons": {
      "items": {
        "enum": [
          "low_confidence",
          "churn_risk",
          "legal_or_security",
          "p1_incident",
          "conflicting_intents",
          "missing_account_id",
          "prompt_injection_suspected",
          "sensitive_data_present"
        ],
        "type": "string"
      },
      "title": "Escalation Reasons",
      "type": "array"
    },
    "missing_info": {
      "items": {
        "enum": [
          "account_id",
          "affected_users_count",
          "device_and_app_version",
          "error_message_or_screenshot",
          "invoice_number",
          "job_or_visit_reference",
          "file_sample",
          "steps_to_reproduce",
          "clear_problem_description"
        ],
        "type": "string"
      },
      "title": "Missing Info",
      "type": "array"
    },
    "summary": {
      "maxLength": 800,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "suggested_next_action": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Suggested Next Action",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "rationale": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "intent",
    "priority",
    "queue",
    "escalate",
    "summary",
    "suggested_next_action",
    "confidence",
    "rationale"
  ],
  "title": "TriageResult",
  "type": "object"
}
